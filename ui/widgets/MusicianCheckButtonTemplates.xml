<Ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="http://www.blizzard.com/wow/ui/">

	<Script file="MusicianCheckButtonTemplates.lua" />

	<!-- Common check button template -->

	<CheckButton name="MusicianCheckButtonArtTemplate" inherits="SettingsCheckboxTemplate" virtual="true">
		<HighlightTexture atlas="checkbox-minimal" useAtlasSize="true" alphaMode="ADD" />
		<HitRectInsets>
			<AbsInset left="0" right="0" top="0" bottom="0" />
		</HitRectInsets>
		<Scripts>
			<!-- Prevent SettingsCheckboxMixin from overriding the OnEnter and OnLeave scripts -->
			<OnLoad function="nop" />
			<OnClick function="MusicianCheckButtonTemplate_OnClick" />
			<OnEnable function="MusicianCheckButtonTemplate_OnEnable" />
			<OnDisable function="MusicianCheckButtonTemplate_OnDisable" />
			<OnEnter function="MusicianCheckButtonTemplate_OnEnter" />
			<OnLeave function="MusicianCheckButtonTemplate_OnLeave" />
		</Scripts>
	</CheckButton>

	<!-- Small check button -->

	<CheckButton name="MusicianSmallCheckButtonTemplate" virtual="true" inherits="MusicianCheckButtonArtTemplate">
		<Size>
			<AbsDimension x="16" y="16" />
		</Size>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" inherits="GameFontHighlightSmall" parentKey="Text">
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" x="2" y="0" />
					</Anchors>
					<Scripts>
						<OnLoad function="UICheckButtonFontString_SetParentKeyAlias" />
					</Scripts>
				</FontString>
			</Layer>
		</Layers>
	</CheckButton>

	<!-- Large check button -->

	<CheckButton name="MusicianLargeCheckButtonTemplate" virtual="true" inherits="MusicianCheckButtonArtTemplate">
		<Size>
			<AbsDimension x="26" y="26" />
		</Size>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" inherits="GameFontHighlightLeft" parentKey="Text">
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" x="-2" y="0" />
					</Anchors>
					<Scripts>
						<OnLoad function="UICheckButtonFontString_SetParentKeyAlias" />
					</Scripts>
				</FontString>
			</Layer>
		</Layers>
	</CheckButton>

	<!-- Option check button -->

	<CheckButton name="MusicianOptionCheckButtonTemplate" virtual="true" inherits="MusicianCheckButtonArtTemplate">
		<Size>
			<AbsDimension x="20" y="20" />
		</Size>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" inherits="GameFontHighlightLeft" parentKey="Text">
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" x="1" y="0" />
					</Anchors>
					<Scripts>
						<OnLoad function="UICheckButtonFontString_SetParentKeyAlias" />
					</Scripts>
				</FontString>
			</Layer>
		</Layers>
	</CheckButton>

	<!-- Sub option check button -->

	<CheckButton name="MusicianSubOptionCheckButtonTemplate" virtual="true" inherits="MusicianCheckButtonArtTemplate">
		<Size>
			<AbsDimension x="20" y="20" />
		</Size>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" inherits="GameFontHighlightSmall" parentKey="Text">
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" x="3" y="1" />
					</Anchors>
					<Scripts>
						<OnLoad function="UICheckButtonFontString_SetParentKeyAlias" />
					</Scripts>
				</FontString>
			</Layer>
		</Layers>
	</CheckButton>
</Ui>